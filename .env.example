# Copy to .env (local) or set these in your host's environment settings.
# All three are optional: the app runs without them, with reduced data.
# Keep them server-side. Never prefix them with NEXT_PUBLIC_.

# ransomware.live Pro API key (https://www.ransomware.live).
# Without it the public API is used: fewer fields, no group profiles with full history.
RANSOMWARE_API_KEY=

# NVD API key (free: https://nvd.nist.gov/developers/request-an-api-key).
# Without it NVD allows about 5 requests per 30 seconds instead of 50.
NVD_API_KEY=

# IPinfo Lite token (free: https://ipinfo.io/lite).
# Without it the scanner layer is empty, because attacker IPs cannot be placed on the map.
IPINFO_TOKEN=

# Public address of the deployed site, used for canonical links, social cards and the sitemap.
# Only needed if it is not https://threat.triada.in. No trailing slash. Set it before the build.
SITE_URL=
